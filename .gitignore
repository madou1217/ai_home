**/target/
**/*.pdb
**/*.dSYM/
desktop/src-tauri/gen/
**/dist/
**/build/
**/coverage/
**/.cache/
**/.turbo/
**/.next/
**/out/

# Ignored as requested
codex-auto-reg/
/cli/
ai-home*.zip
output/

# UmiJS temporary cache
web/src/.umi/
web/src/.umi-production/
/.umi-production/

# WebUI 终端运行时生成的 aih shim（见 webui-terminal-routes.js）
.runtime-bin/

# Local AIH/Grok runtime state and generated artifacts.
/.config-init.lock
/.metadata_version
/active_sessions.json
/active_sessions.lock
/agent_id
/config.toml
/managed_config.lock
/bin/native/
/sessions/
/docs/user-guide/
/[[]object Object[]]/
.tmp-mitm/

# Local agent and browser-automation scratch artifacts.
/.omo/
/.playwright-*
# GUI 测试取证截图（web-gui-tester skill 的本地证据目录）。
gui-test-screenshots/
# 本地 HTML 设计原型稿，不入库。
prototypes/

# Local code-index tool database (per-machine, never shared).
/.codegraph/

# 依赖锁文件不入库：各平台客户端本地 npm install 时重新生成，避免跨机器解析差异造成冲突。
# CI 对应使用 npm install（无锁文件可 ci）。误用 pnpm 生成的锁文件同样忽略。
package-lock.json
web/package-lock.json
pnpm-lock.yaml
web/pnpm-lock.yaml

# Windows 保留设备名。PowerShell 的空设备是 $null，`2>nul` 不会丢弃输出而是
# 创建一个名为 nul 的真实文件（cmd/批处理里 >nul 才是丢弃，仓库内的用法都在
# cmd.exe 或 .bat 上下文，无此问题）。这类文件一律是外部工具在仓库目录下误留，
# 永远不是正当内容——忽略掉，免得污染 git status 或被误提交。
nul

# Windows 盘符路径。测试用 'C:\harness\.codex' 之类字面量模拟 win32 的 CODEX_HOME，
# 在 POSIX 上 path.join 不解析反斜杠，一旦某条代码路径真去写这个"目录"，就会在仓库
# 根下创建一个名字里带反斜杠的真实目录。同 nul 一样，永远不是正当内容。
C:\\*

# Documentation policy: keep root entry docs, the Web design-system spec,
# and the Fabric design pack.
*.md
!/AGENTS.md
!/README.md
!/web/DESIGN.md
!/docs/
!/docs/**
# aih-collab built-in skill: runtime asset shipped with the CLI, not documentation.
!/assets/provider-skills/
!/assets/provider-skills/**

# Generated bundles copied from external Codex/Electron builds.
/app-session-*.js
/app-session-*.js.map
/main-*.js
/main-*.js.map
/workspace-root-drop-handler-*.js
/workspace-root-drop-handler-*.js.map

# Rust / Tauri / TUI build artifacts
**/target/
**/*.pdb
**/*.dSYM/
desktop/src-tauri/gen/
**/dist/
**/build/
**/coverage/
**/.cache/
**/.turbo/
**/.next/
**/out/

# Ignored as requested
codex-auto-reg/
/cli/
ai-home*.zip
output/

# UmiJS temporary cache
web/src/.umi/
web/src/.umi-production/
/.umi-production/

# WebUI 终端运行时生成的 aih shim（见 webui-terminal-routes.js）
.runtime-bin/


#!/bin/sh
# aih 入口：直接 exec 原生 Go CLI，不经过 Node。
# 原生二进制缺失时 Claude 明确失败；其它旧命令暂保留 Node 兼容入口。
set -e

target=$0
# npm 生成的是符号链接，先解析到包内真实路径。
while [ -L "$target" ]; do
  link=$(readlink "$target")
  case $link in
    /*) target=$link ;;
    *) target=$(dirname -- "$target")/$link ;;
  esac
done
dir=$(CDPATH= cd -- "$(dirname -- "$target")" && pwd)

case $(uname -s) in
  Darwin) platform=darwin ;;
  Linux) platform=linux ;;
  *) platform=$(uname -s | tr '[:upper:]' '[:lower:]') ;;
esac
case $(uname -m) in
  arm64|aarch64) arch=arm64 ;;
  x86_64|amd64) arch=amd64 ;;
  *) arch=$(uname -m) ;;
esac

native="$dir/native/$platform-$arch/aih-go"
if [ -x "$native" ]; then
  exec "$native" "$@"
fi

if [ "${1:-}" = claude ] || [ "${1:-}" = peer ]; then
  printf '%s\n' '[aih] Go CLI 未构建；请运行 npm run go:build。Claude / peer 不会回落到 Node。' >&2
  exit 126
fi
exec node "$dir/ai-home.js" "$@"

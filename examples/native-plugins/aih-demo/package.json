{
  "name": "aih-demo-plugin",
  "version": "1.0.0",
  "type": "module",
  "description": "AIH portable native plugin demo",
  "agentPlugin": {
    "manifestVersion": 1,
    "portableApiVersion": 1,
    "pluginId": "aih-demo",
    "core": "./dist/core.mjs",
    "engines": {
      "deepseek": ">=0.2.1-rc.2",
      "opencode": ">=1.17.0",
      "pi": ">=0.84.4",
      "aih": ">=1.0.0"
    },
    "capabilities": [
      {
        "id": "lifecycle",
        "version": 1,
        "required": true
      },
      {
        "id": "tool.register",
        "version": 1,
        "required": false
      }
    ],
    "permissions": {
      "network": [],
      "filesystem": [
        "private-state"
      ],
      "secrets": []
    }
  },
  "exports": {
    ".": "./dist/core.mjs",
    "./opencode/server": "./dist/hosts/opencode-server.mjs",
    "./pi": "./dist/hosts/pi.mjs",
    "./deepseek": "./dist/hosts/deepseek.mjs"
  },
  "pi": {
    "extensions": [
      "./dist/hosts/pi.mjs"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./dist/hosts/deepseek/cordis.patch.yml"
    }
  }
}

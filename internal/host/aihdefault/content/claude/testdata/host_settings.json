{
  "permissions": {
    "allow": [
      "Bash(go test:*)",
      "Read"
    ]
  },
  "env": {
    "ANTHROPIC_API_KEY": "sk-host-api-key",
    "ANTHROPIC_AUTH_TOKEN": "sk-host-token",
    "ANTHROPIC_BASE_URL": "https://relay.example.com/v1/",
    "ANTHROPIC_CUSTOM_HEADERS": "x-user-header: keep-me\nx-account-ref: acct_0123456789abcdef0123",
    "CLAUDE_CODE_MAX_CONTEXT_TOKENS": 200000,
    "DISABLE_TELEMETRY": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "aih statusline"
  }
}

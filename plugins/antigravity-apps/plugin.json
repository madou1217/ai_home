{
  "manifestVersion": 1,
  "kind": "capability",
  "protocolVersion": 1,
  "pluginId": "antigravity.apps",
  "version": "1.2.1",
  "engines": {
    "aih": ">=1.0.0"
  },
  "runtime": "node",
  "entry": "index.js",
  "permissions": {
    "network": [
      "https://antigravity.google",
      "https://storage.googleapis.com",
      "https://edgedl.me.gvt1.com"
    ],
    "filesystem": {
      "read": [
        "state"
      ],
      "write": [
        "state"
      ]
    },
    "secrets": [],
    "environment": [],
    "installers": true
  },
  "contributes": [
    {
      "id": "antigravity.apps.install",
      "capability": "app.install",
      "version": 1,
      "failurePolicy": "delegate",
      "scope": {
        "providers": [
          "agy"
        ]
      }
    }
  ]
}

    "content": "{\n  \"model\": \"gpt-5\",\n  \"api_key\": \"sk-secret\",\n  \"nested\": {\n    \"access_token\": \"tok\",\n    \"refresh_token\": \"rt\",\n    \"provider\": \"google\",\n    \"region\": \"us-east-1\"\n  },\n  \"list\": [\n    {\n      \"password\": \"p1\",\n      \"name\": \"a\"\n    },\n    {\n      \"client_secret\": \"cs\",\n      \"mode\": \"safe\"\n    }\n  ],\n  \"token_type\": \"Bearer\",\n  \"expires\": 123\n}",
    "output": "{\n  \"model\": \"gpt-5\",\n  \"api_key\": \"<redacted>\",\n  \"nested\": {\n    \"access_token\": \"<redacted>\",\n    \"refresh_token\": \"<redacted>\",\n    \"provider\": \"google\",\n    \"region\": \"us-east-1\"\n  },\n  \"list\": [\n    {\n      \"password\": \"<redacted>\",\n      \"name\": \"a\"\n    },\n    {\n      \"client_secret\": \"<redacted>\",\n      \"mode\": \"safe\"\n    }\n  ],\n  \"token_type\": \"<redacted>\",\n  \"expires\": 123\n}\n",
    "fields": [
